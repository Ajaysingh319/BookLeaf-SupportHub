# Copy to ".env" (git-ignored) and fill in your values.

# Development only: where the Vite dev server forwards /api requests (the backend address).
DEV_API_PROXY_TARGET=http://localhost:8080

# Deployed build only: public address of the API, for example https://api.example.com
# Leave empty to call the same origin that serves the app. This is a public address:
# never put secrets or API keys in VITE_ variables.
VITE_API_BASE_URL=
