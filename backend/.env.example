# Copy this file to ".env" (git-ignored) in the backend folder and fill in your values.
# Real environment variables override .env. Keep real secrets (marked SECRET) in your
# operating-system environment or your host's secret store, not in this file.

# Many hosts provide PORT themselves
PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/your_database
DB_USERNAME=your_database_user
# SECRET: DB_PASSWORD (environment variable only)
# "validate": the schema comes from Flyway migrations; startup fails if entities and schema drift apart
JPA_DDL_AUTO=validate

# SECRET: AUTH_SECRET, a random string of at least 32 characters (environment variable only)
# Minutes of inactivity before a session ends (it renews while in use)
TOKEN_TTL_MINUTES=60

# Exact browser origin of the frontend
CLIENT_ORIGIN=http://localhost:5173

# Session cookie. Local development is plain HTTP, so Secure is off; production must use true.
# Cookie sessions need the app and API on the same site (same-site deployment).
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# AI provider. LLM_API_KEY is a SECRET (environment variable only); leave it unset to run without AI.
LLM_PROVIDER_NAME=openai
LLM_MODEL=gpt-4o-mini
# Optional. Only for "thinking" models such as Gemini 3.x: none, minimal or low stops hidden reasoning
# tokens from cutting the answer off. Leave it out for models that do not support it (e.g. gpt-4o-mini).
# LLM_REASONING_EFFORT=none
LLM_BASE_URL=https://api.openai.com/v1

# Shown in the client
APP_BRAND_NAME=BookLeaf Support
# ISO 4217 currency code and a BCP 47 locale (ASCII only: .env files are read as ISO-8859-1)
APP_CURRENCY_CODE=INR
APP_LOCALE=en-IN

# Only needed when running the sample data import.
# SECRET (environment variables only): SEED_AUTHOR_PASSWORD, SEED_ADMIN_PASSWORD
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Support Admin
