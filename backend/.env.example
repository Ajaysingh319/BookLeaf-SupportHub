# Copy this file to ".env" (git-ignored) in the backend folder and fill in your values.
# Real environment variables override .env. Keep real secrets (marked SECRET) in your
# operating-system environment or your host's secret store, not in this file.

SERVER_PORT=8080

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/your_database
DB_USERNAME=your_database_user
# SECRET: DB_PASSWORD (environment variable only)
JPA_DDL_AUTO=update

# SECRET: AUTH_SECRET, a random string of at least 32 characters (environment variable only)
TOKEN_TTL_MINUTES=480

# Exact browser origin of the frontend
CLIENT_ORIGIN=http://localhost:5173

# AI provider. LLM_API_KEY is a SECRET (environment variable only); leave it unset to run without AI.
LLM_PROVIDER_NAME=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Shown in the client
APP_BRAND_NAME=BookLeaf Support
# ISO 4217 currency code and a BCP 47 locale (ASCII only: .env files are read as ISO-8859-1)
APP_CURRENCY_CODE=INR
APP_LOCALE=en-IN

# Only needed when running the sample data import.
# SECRET (environment variables only): SEED_AUTHOR_PASSWORD, SEED_ADMIN_PASSWORD
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Support Admin
